Algoritmo "DESAFIO"

Const
   // Limites do sistema
   MAX_LIVROS = 40
   MAX_CATEGORIAS = 5

   // Categorias dos livros
   TECNOLOGIA = 1
   EXATAS = 2
   HUMANAS = 3
   NEGOCIOS = 4
   LITERATURA = 5
   
   // Tipo de movimenta��o
   EMPRESTIMO = 1
   DEVOLUCAO = 2
   
   // Status de disponibilidade
   DISPONIVEL = 1
   INDISPONIVEL = 0
   
Tipo
    // Cria um registro com as informa��es necess�rias de um livro
    Livro = registro
          codigo: inteiro
          titulo: caractere
          autor: caractere
          ano: inteiro
          categoria: inteiro
          qtdTotal: inteiro
          qtdDisponivel: inteiro
          qtdEmprestimos: inteiro
          status: inteiro
    fimregistro
    
Var
   // Globais: compartilhadas por v�rias sub-rotinas do sistema
   qtdLivros, opcao: inteiro   // qtdLivros = posi��es usadas do acervo; opcao = escolha do menu
   acervo: vetor[1..MAX_LIVROS] de Livro   // vetor de registros com todos os livros
   movimentacoes: vetor[1..MAX_CATEGORIAS, 1..2] de inteiro   // linhas = categorias; colunas = EMPRESTIMO e DEVOLUCAO

// Prepara os dados do sistema antes de come�ar a execu��o
procedimento Inicializar()
Var
   i, j: inteiro

Inicio
             qtdLivros <- 0
             // Zera os registros de movimenta��o no in�cio do programa
             para i de 1 ate MAX_CATEGORIAS faca
                  para j de 1 ate 2 faca
                       movimentacoes[i, j] <- 0
                  fimpara
             fimpara
fimprocedimento

// Busca sequencial pelo c�digo. Recebe o c�digo por par�metro e retorna a posi��o no vetor (0 = n�o existe)
funcao BuscarLivro(codigoBusca: inteiro): inteiro
Var
   i, resultado: inteiro

Inicio
      resultado <- 0   // 0 = n�o encontrado
      i <- 1

       // Percorre o acervo at� achar o c�digo ou acabar os livros
       enquanto (i <= qtdLivros) e (resultado = 0) faca
                se acervo[i].codigo = codigoBusca entao
                   resultado <- i
                fimse
                i <- i + 1
       fimenquanto

       retorne resultado
fimfuncao

// Retorna quantos exemplares do livro na posi��o informada est�o emprestados agora (qtdTotal - qtdDisponivel)
funcao QuantidadeEmprestada(posicao: inteiro): inteiro
Inicio
      retorne acervo[posicao].qtdTotal - acervo[posicao].qtdDisponivel
fimfuncao

// Busca bin�ria recursiva (o acervo precisa estar ordenado por c�digo).
// ini e limite delimitam o intervalo pesquisado, que cai pela metade a cada chamada. Retorna a posi��o ou 0.
funcao BuscarRecursivo(codigoBusca, ini, limite: inteiro): inteiro
Var
   meio, resultado: inteiro

Inicio
      resultado <- 0   // 0 = n�o encontrado

      // Caso-base 1: se ini > limite, n�o h� mais posi��es para pesquisar
      // e a fun��o retorna 0 (n�o encontrado) sem fazer nova chamada
      se ini <= limite entao
         meio <- (ini + limite) \ 2

         // Caso-base 2: o c�digo foi encontrado na posi��o do meio
         se acervo[meio].codigo = codigoBusca entao
            resultado <- meio
         senao
              // Chamada recursiva na metade inferior ou na superior
              se codigoBusca < acervo[meio].codigo entao
                 resultado <- BuscarRecursivo(codigoBusca, ini, meio - 1)
              senao
                   resultado <- BuscarRecursivo(codigoBusca, meio + 1, limite)
              fimse
         fimse
      fimse

      retorne resultado
fimfuncao

procedimento CadastrarLivro()
Var
   posicao, codigoNovo: inteiro
   duplicado: logico

Inicio
      // Verifica se ainda h� espa�o para cadastrar um novo livro
      se qtdLivros >= MAX_LIVROS entao
         escreval ("Limite de livros cadastrados atingido")
      senao
           posicao <- qtdLivros + 1

           // O c�digo fica em codigoNovo e s� vai para o acervo depois de validado,
           // assim a BuscarLivro compara apenas com os livros j� cadastrados
           repita
                 escreva ("Digite o c�digo do livro: ")
                 leia(codigoNovo)

                 se BuscarLivro(codigoNovo) <> 0 entao
                    duplicado <- verdadeiro
                    escreval ("Esse c�digo j� est� cadastrado! Digite outro.")
                 senao
                      duplicado <- falso
                 fimse

           ate nao duplicado

           acervo[posicao].codigo <- codigoNovo

           escreva("Digite o t�tulo do livro: ")
           leia(acervo[posicao].titulo)

           escreva("Digite o autor do livro: ")
           leia(acervo[posicao].autor)

           // Garante que o ano informado seja v�lido
           repita
                 escreva ("Digite o ano do livro: ")
                 leia(acervo[posicao].ano)

                 se acervo[posicao].ano <= 0 entao
                    escreval ("O ano deve ser maior que zero!")
                 fimse

           ate acervo[posicao].ano > 0

           // Garante que a categoria esteja entre 1 e 5
           repita
                 escreva ("Digite o n�mero da categoria (1-Tecnologia, 2-Exatas, 3-Humanas, 4-Neg�cios, 5-Literatura): ")
                 leia(acervo[posicao].categoria)

                 se (acervo[posicao].categoria <= 0) ou (acervo[posicao].categoria >= 6) entao
                    escreval ("A categoria deve estar entre 1 e 5!")
                 fimse

           ate (acervo[posicao].categoria >= 1) e (acervo[posicao].categoria <= 5)

           // Garante que exista pelo menos um exemplar
           repita
                 escreva ("Digite a quantidade de exemplares do livro: ")
                 leia(acervo[posicao].qtdTotal)

                 se acervo[posicao].qtdTotal <= 0 entao
                    escreval ("A quantidade deve ser maior que zero!")
                 fimse

           ate acervo[posicao].qtdTotal > 0

           // Define os dados iniciais do livro ap�s o cadastro
           acervo[posicao].qtdDisponivel <- acervo[posicao].qtdTotal
           acervo[posicao].qtdEmprestimos <- 0
           acervo[posicao].status <- DISPONIVEL

           // Atualiza a quantidade de livros cadastrados
           qtdLivros <- qtdLivros + 1
      fimse
fimprocedimento

