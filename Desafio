                escreval ("Dispon�veis: ", acervo[i].qtdDisponivel)
                escreval ("Empr�stimos : ", acervo[i].qtdEmprestimos)
                
                se acervo[i].status = DISPONIVEL entao
                   escreval ("Status: Dispon�vel")
